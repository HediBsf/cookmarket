sequenceDiagram
    title Diagramme de séquence - Confirmation du paiement D17
    participant Vendeur as Vendeur
    participant Frontend as Tableau de bord vendeur
    participant OrdersController as Controleur des commandes
    participant OrdersService as Service des commandes
    participant DB as Base de donnees

    Vendeur->>Frontend: Acceder a la gestion des commandes
    activate Frontend
    Frontend->>OrdersController: GET /orders/seller/:sellerId
    activate OrdersController
    OrdersController->>OrdersService: chercherParVendeur(idVendeur)
    activate OrdersService
    OrdersService->>DB: Lire les commandes du vendeur
    activate DB
    DB-->>OrdersService: Liste des commandes
    deactivate DB
    OrdersService-->>OrdersController: Resultat
    deactivate OrdersService
    OrdersController-->>Frontend: Liste des commandes
    deactivate OrdersController
    Frontend-->>Vendeur: Afficher les commandes recues
    deactivate Frontend

    Vendeur->>Frontend: Selectionner une commande avec paiement D17
    activate Frontend
    Frontend-->>Vendeur: Afficher la preuve de paiement D17
    deactivate Frontend

    Vendeur->>Frontend: Confirmer la validite du paiement
    activate Frontend
    Frontend->>OrdersController: PATCH /orders/:id/confirm-d17
    activate OrdersController
    OrdersController->>OrdersService: confirmerPaiementD17(idCommande, idVendeur)

    alt preuve valide
        OrdersService->>DB: Mettre a jour le statut du paiement
        activate DB
        DB-->>OrdersService: Paiement confirme
        deactivate DB
        OrdersService-->>OrdersController: Succes
        OrdersController-->>Frontend: Confirmation
        Frontend-->>Vendeur: Afficher un message de succes

        Frontend->>OrdersController: GET /orders/seller/:sellerId
        OrdersController->>OrdersService: chercherParVendeur(idVendeur)
        activate OrdersService
        OrdersService->>DB: Lire les commandes actualisees
        activate DB
        DB-->>OrdersService: Liste mise a jour
        deactivate DB
        OrdersService-->>OrdersController: Resultat
        deactivate OrdersService
        OrdersController-->>Frontend: Liste actualisee
        Frontend-->>Vendeur: Rafraichir l'affichage
    else preuve invalide
        OrdersService-->>OrdersController: Preuve invalide
        OrdersController-->>Frontend: Message d'erreur
        Frontend-->>Vendeur: Afficher un message d'erreur
    end
    deactivate OrdersController
    deactivate Frontend
