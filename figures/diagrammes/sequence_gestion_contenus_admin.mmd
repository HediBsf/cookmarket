sequenceDiagram
    title Diagramme de séquence - Gestion des contenus administrateur
    participant Administrateur as Administrateur
    participant Frontend as Tableau de bord administrateur
    participant AdminController as Controleur admin
    participant AdminService as Service admin
    participant DB as Base de donnees

    Administrateur->>Frontend: Acceder a la gestion des contenus
    activate Frontend
    Frontend->>AdminController: GET /admin/dishes et /admin/formations
    activate AdminController
    AdminController->>AdminService: plats() et formations()
    activate AdminService
    AdminService->>DB: Lire les plats et les formations
    activate DB
    DB-->>AdminService: Listes des contenus
    deactivate DB
    AdminService-->>AdminController: Resultats
    deactivate AdminService
    AdminController-->>Frontend: Donnees des contenus
    deactivate AdminController
    Frontend-->>Administrateur: Afficher les plats et les formations

    alt suppression d'un plat
        Administrateur->>Frontend: Supprimer un plat
        Frontend->>AdminController: DELETE /admin/dishes/:id
        activate AdminController
        AdminController->>AdminService: supprimerPlat(id)
        activate AdminService
        AdminService->>DB: Supprimer le plat
        activate DB
        DB-->>AdminService: Suppression effectuee
        deactivate DB
        AdminService-->>AdminController: Confirmation
        deactivate AdminService
        AdminController-->>Frontend: Reponse de succes
        deactivate AdminController
        Frontend-->>Administrateur: Afficher un message de succes
    else suppression d'une formation
        Administrateur->>Frontend: Supprimer une formation
        Frontend->>AdminController: DELETE /admin/formations/:id
        activate AdminController
        AdminController->>AdminService: supprimerFormation(id)
        activate AdminService
        AdminService->>DB: Supprimer la formation
        activate DB
        DB-->>AdminService: Suppression effectuee
        deactivate DB
        AdminService-->>AdminController: Confirmation
        deactivate AdminService
        AdminController-->>Frontend: Reponse de succes
        deactivate AdminController
        Frontend-->>Administrateur: Afficher un message de succes
    end
    deactivate Frontend
