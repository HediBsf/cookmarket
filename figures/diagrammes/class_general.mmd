---
title: Diagramme de classes general - CookMarket
---
classDiagram
  direction LR

  class Utilisateur {
    +Int id
    +String firstName
    +String lastName
    +String email
    +String password
    +String phone
    +String city
    +String address
    +String profileImageUrl
    +Role role
    +Boolean emailVerified
    +DateTime createdAt
    +DateTime updatedAt
  }

  class Client {
    +consulterPlats()
    +consulterRecettes()
    +passerCommande()
    +suivreCommande()
    +commenterRecette()
    +consulterNotifications()
  }

  class Vendeur {
    +String sellerSubscriptionStatus
    +DateTime sellerSubscriptionExpiresAt
    +String sellerSubscriptionReference
    +String sellerSubscriptionProof
    +String sellerD17PhoneNumber
    +gererPlats()
    +gererFormations()
    +traiterCommandes()
    +confirmerPaiementD17()
  }

  class Administrateur {
    +consulterTableauDeBord()
    +gererUtilisateurs()
    +verifierUtilisateurs()
    +confirmerAbonnementVendeur()
    +superviserCommandes()
    +traiterTicketsSupport()
  }

  class Plat {
    +Int id
    +String name
    +String description
    +Float price
    +String imageUrl
    +Int quantity
    +Boolean availability
    +Int preparationTime
    +String city
    +String allergens
    +DateTime createdAt
    +DateTime updatedAt
  }

  class Recette {
    +Int id
    +String title
    +String description
    +String imageUrl
    +String ingredients
    +String steps
    +Int preparationTime
    +Int cookingTime
    +String difficulty
    +Int servings
    +DateTime createdAt
    +DateTime updatedAt
  }

  class Commande {
    +Int id
    +Float totalPrice
    +String customerFirstName
    +String customerLastName
    +String customerEmail
    +String customerPhone
    +OrderStatus status
    +String deliveryAddress
    +String deliveryCity
    +Float deliveryFee
    +String paymentMethod
    +String paymentStatus
    +String d17PhoneNumber
    +String d17TransferReference
    +String d17TransferProof
    +Boolean sellerPaid
    +DateTime createdAt
    +DateTime updatedAt
  }

  class LigneCommande {
    +Int id
    +Int quantity
    +Float unitPrice
    +Float subtotal
  }

  class Avis {
    +Int id
    +Int rating
    +String comment
    +DateTime createdAt
  }

  class Commentaire {
    +Int id
    +String content
    +DateTime createdAt
  }

  class Notification {
    +Int id
    +String title
    +String message
    +Boolean read
    +Int orderId
    +DateTime createdAt
  }

  class NotificationClient {
    +Int id
    +String title
    +String message
    +Boolean read
    +Int orderId
    +DateTime createdAt
  }

  class Categorie {
    +Int id
    +String name
    +String type
  }

  class Formation {
    +Int id
    +String title
    +String description
    +Float price
    +String duration
    +String level
    +String imageUrl
    +Boolean availability
    +DateTime createdAt
    +DateTime updatedAt
  }

  class TicketSupport {
    +Int id
    +String subject
    +String message
    +String reply
    +String status
    +Boolean readByAdmin
    +DateTime createdAt
    +DateTime updatedAt
    +DateTime repliedAt
  }

  class Role {
    <<enumeration>>
    CLIENT
    SELLER
    ADMIN
  }

  class OrderStatus {
    <<enumeration>>
    PENDING
    ACCEPTED
    PREPARING
    READY
    DELIVERING
    DELIVERED
    CANCELLED
  }

  Utilisateur <|-- Client
  Utilisateur <|-- Vendeur
  Utilisateur <|-- Administrateur
  Utilisateur --> Role : possede
  Commande --> OrderStatus : possede

  Vendeur "1" --> "0..*" Plat : publie
  Vendeur "1" --> "0..*" Formation : propose
  Client "1" --> "0..*" Commande : passe
  Commande "1" --> "1..*" LigneCommande : contient
  LigneCommande "0..*" --> "0..1" Plat : reference
  LigneCommande "0..*" --> "0..1" Formation : reference

  Utilisateur "1" --> "0..*" Recette : publie
  Recette "1" --> "0..*" Commentaire : recoit
  Client "1" --> "0..*" Commentaire : redige

  Client "1" --> "0..*" Avis : redige
  Plat "1" --> "0..*" Avis : recoit

  Categorie "1" --> "0..*" Plat : classe
  Categorie "1" --> "0..*" Recette : classe

  Vendeur "1" --> "0..*" Notification : recoit
  Client "1" --> "0..*" NotificationClient : recoit
  Utilisateur "1" --> "0..*" TicketSupport : ouvre
  Administrateur "1" --> "0..*" TicketSupport : repond
