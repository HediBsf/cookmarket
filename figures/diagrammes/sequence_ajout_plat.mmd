sequenceDiagram
    title Diagramme de sequence - Ajout d'un plat
    participant Vendeur as Vendeur
    participant Frontend as Tableau de bord vendeur
    participant DishesController as Controleur des plats
    participant DishesService as Service des plats
    participant DB as Base de donnees

    Vendeur->>Frontend: Ouvrir le formulaire d'ajout d'un plat
    activate Frontend
    Frontend-->>Vendeur: Afficher le formulaire
    deactivate Frontend

    Vendeur->>Frontend: Saisir les informations du plat
    Vendeur->>Frontend: Valider l'ajout
    activate Frontend
    Frontend->Frontend: Verifier les champs obligatoires
    activate Frontend
    deactivate Frontend

    alt donnees valides
        Frontend->>DishesController: POST /dishes
        activate DishesController
        DishesController->>DishesService: creer(donnees, idVendeur)
        activate DishesService
        DishesService->>DB: Enregistrer le plat
        activate DB
        DB-->>DishesService: Plat enregistre
        deactivate DB
        DishesService-->>DishesController: Plat enregistre
        deactivate DishesService
        DishesController-->>Frontend: Confirmation
        deactivate DishesController
        Frontend-->>Vendeur: Afficher un message de succes
    else donnees invalides
        Frontend-->>Vendeur: Afficher un message d'erreur
    end
    deactivate Frontend
