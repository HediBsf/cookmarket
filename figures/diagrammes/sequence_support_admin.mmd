sequenceDiagram
    title Diagramme de séquence - Traitement d'un ticket support
    participant Administrateur as Administrateur
    participant Frontend as Tableau de bord administrateur
    participant AdminController as Controleur admin
    participant AdminService as Service admin
    participant DB as Base de donnees

    Administrateur->>Frontend: Ouvrir les tickets support
    activate Frontend
    Frontend->>AdminController: GET /admin/support
    activate AdminController
    AdminController->>AdminService: ticketsSupport()
    activate AdminService
    AdminService->>DB: Lire les tickets support
    activate DB
    DB-->>AdminService: Liste des tickets
    deactivate DB
    AdminService-->>AdminController: Resultat
    deactivate AdminService
    AdminController-->>Frontend: Tickets support
    deactivate AdminController
    Frontend-->>Administrateur: Afficher les demandes d'aide

    Administrateur->>Frontend: Rediger une reponse
    Frontend->>AdminController: PATCH /admin/support/:id/reply
    activate AdminController
    AdminController->>AdminService: repondreTicketSupport(id, idAdmin, reponse)
    activate AdminService

    alt reponse valide
        AdminService->>DB: Mettre a jour le ticket et creer une notification client
        activate DB
        DB-->>AdminService: Ticket mis a jour
        deactivate DB
        AdminService-->>AdminController: Confirmation
        AdminController-->>Frontend: Reponse de succes
        Frontend-->>Administrateur: Afficher ticket traite
    else reponse invalide
        AdminService-->>AdminController: Erreur de validation
        AdminController-->>Frontend: Message d'erreur
        Frontend-->>Administrateur: Afficher un message d'erreur
    end
    deactivate AdminService
    deactivate AdminController
    deactivate Frontend
